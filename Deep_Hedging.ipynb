     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# set random seeds\n",
    "np.random.seed(1)\n",
    "torch.manual_seed(1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "0be97114",
   "metadata": {
    "id": "0be97114"
   },
   "outputs": [],
   "source": [
    "TRAIN_SIZE = int(1e6)\n",
    "TEST_SIZE = int(1e5)\n",
    "N = 30  # number of time steps\n",
    "S_0 = 1  # initial stock price\n",
    "T = 30 / 365  # one month\n",
    "SIGMA = 0.5\n",
    "K = 1  # strike price also known as the exercise price\n",
    "R = 0  # risk-free interest rate"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "deb46d29",
   "metadata": {
    "id": "deb46d29"
   },
   "outputs": [],
   "source": [
    "class OptionsDataSet(Dataset):\n",
    "    \"\"\"Options dataset.\"\"\"\n",
    "\n",
    "    def __init__(self, size):\n",
    "        self.size = size\n",
    "        # Generate the training set\n",
    "        z = np.random.normal(size=(size, N))\n",
    "        self.data = np.zeros((size, N + 1))\n",
    "        self.data[:, 0] = S_0\n",
    "        for i in range(1, N + 1):\n",
    "            self.data[:, i] = self.data[:, i - 1] * np.exp(\n",
    "                -(SIGMA**2) / 2 * T / N + SIGMA * np.sqrt(T / N) * z[:, i - 1]\n",
    "            )\n",
    "\n",
    "    def __len__(self):\n",
    "        return self.data.shape[0]\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        return self.data[idx]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "46481cfb",
   "metadata": {
    "id": "46481cfb"
   },
   "outputs": [],
   "source": [
    "# Generate the training set\n",
    "train_dataset = OptionsDataSet(TRAIN_SIZE)\n",
    "\n",
    "# Generate the test set\n",
    "test_dataset = OptionsDataSet(TEST_SIZE)"
   ]
  },
